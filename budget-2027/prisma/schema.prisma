// Budget 2027 — data model.
// Principles: every observation cites a SourceDocument + locator; values are exact decimals
// (null = no data, never 0); snapshots are immutable; publishing is an explicit, audited act.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VersionStage {
  PUBLIC_DRAFT
  SUBMITTED_BILL
  COMMITTEE
  FIRST_READING
  SECOND_READING
  ENACTED
  PROMULGATED
}

enum Vintage {
  actual
  expected
  plan
  draft
  forecast
}

enum ReviewStatus {
  cross_checked
  single_source
  conflict
  editor_approved
}

enum CheckStatus {
  pass
  warn
  fail
}

enum Role {
  viewer
  researcher
  editor
  publisher
  administrator
}

/// A legal/editorial version of the budget (06.11 draft, 16.11 bill, enacted law, ...).
model BudgetVersion {
  id           String              @id
  label        String
  stage        VersionStage
  date         DateTime            @db.Date
  legalStatus  String
  evidence     String
  documents    SourceDocument[]
  observations MetricObservation[]
  measures     BudgetMeasure[]
}

/// An original file exactly as retrieved; sha256 identifies the bytes.
model SourceDocument {
  id                String              @id
  sha256            String
  bytes             Int
  publisher         String
  title             String
  url               String
  pageUrl           String?
  mime              String
  retrievedOn       DateTime            @db.Date
  publishedOn       DateTime?           @db.Date
  legalStatus       String?
  version           BudgetVersion?      @relation(fields: [versionId], references: [id])
  versionId         String?
  citations         ObservationSource[]
  measures          BudgetMeasure[]
  events            LegislativeEvent[]
  snapshotDocuments SnapshotDocument[]

  @@index([sha256])
}

/// Which documents a snapshot is built from (documents themselves are shared and immutable).
model SnapshotDocument {
  snapshot   DataSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String
  document   SourceDocument @relation(fields: [documentId], references: [id])
  documentId String

  @@id([snapshotId, documentId])
}

/// Small reference datasets of a snapshot (glossary, committees), stored as validated JSON.
model SnapshotReference {
  snapshot   DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String
  key        String
  data       Json

  @@id([snapshotId, key])
}

model ImportJob {
  id         String        @id @default(cuid())
  kind       String // "snapshot-seed" | "sigma-check" | ...
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     String // "running" | "succeeded" | "failed"
  log        String        @default("")
  snapshot   DataSnapshot? @relation(fields: [snapshotId], references: [id])
  snapshotId String?
}

/// Immutable bundle of observations built by scripts/build-snapshot.ts.
model DataSnapshot {
  id                 String              @id // "snap-<content hash>"
  createdAt          DateTime
  retrievedOn        DateTime            @db.Date
  sigmaVersion       String
  publishedAt        DateTime?
  publishedBy        String?
  supersededAt       DateTime?
  observations       MetricObservation[]
  measures           BudgetMeasure[]
  checks             ValidationCheck[]
  versionDiffs       VersionDiff[]
  importJobs         ImportJob[]
  dataTables         DataTable[]
  municipalBudgets   MunicipalBudget[]
  snapshotDocuments  SnapshotDocument[]
  snapshotReferences SnapshotReference[]
}

model Metric {
  key          String              @id
  label        String
  short        String
  definition   String
  scope        String
  basis        String
  unit         String
  changeIn     String
  observations MetricObservation[]
}

model MetricObservation {
  id         String              @id @default(cuid())
  snapshot   DataSnapshot        @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String
  metric     Metric              @relation(fields: [metricKey], references: [key])
  metricKey  String
  version    BudgetVersion       @relation(fields: [versionId], references: [id])
  versionId  String
  period     String
  vintage    Vintage
  /// null = no data published (never coerced to 0)
  value      Decimal?            @db.Decimal(24, 6)
  unit       String
  review     ReviewStatus
  sources    ObservationSource[]
  claims     ClaimEvidence[]

  @@unique([snapshotId, metricKey, versionId, period])
  @@index([metricKey, period])
}

model ObservationSource {
  id            String            @id @default(cuid())
  observation   MetricObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  observationId String
  document      SourceDocument    @relation(fields: [documentId], references: [id])
  documentId    String
  ordinal       Int
  locator       String
  value         Decimal?          @db.Decimal(24, 6)
  original      String?
}

model BudgetMeasure {
  id         String         @id // "<version>:<direction>:<row>"
  snapshot   DataSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String
  version    BudgetVersion  @relation(fields: [versionId], references: [id])
  versionId  String
  direction  String // "revenue" | "expenditure"
  title      String
  effect2027 Decimal?       @db.Decimal(24, 6)
  effect2028 Decimal?       @db.Decimal(24, 6)
  effect2029 Decimal?       @db.Decimal(24, 6)
  unit       String
  basis      String
  document   SourceDocument @relation(fields: [documentId], references: [id])
  documentId String
  locator    String

  @@index([snapshotId, direction])
}

model ValidationCheck {
  id          String       @id @default(cuid())
  snapshot    DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId  String
  checkId     String
  kind        String
  status      CheckStatus
  description String
  details     Json?

  @@unique([snapshotId, checkId])
}

model VersionDiff {
  id         String       @id @default(cuid())
  snapshot   DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String
  fromId     String
  toId       String
  label      String
  period     String
  before     Decimal?     @db.Decimal(24, 6)
  after      Decimal?     @db.Decimal(24, 6)
  difference Decimal?     @db.Decimal(24, 6)
}

/// A whole cited table from an official document (rows/cells as JSON, decimals as strings).
model DataTable {
  snapshot   DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId String
  id         String
  title      String
  documentId String
  data       Json

  @@id([snapshotId, id])
}

/// Transfers from the central budget to one municipality: 2026 (ЗДБ 2026, via SIGMA) and 2027 (bill, чл. 52).
model MunicipalBudget {
  snapshot       DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId     String
  code           String
  name           String
  billName       String
  region         String
  population     Int
  populationAsOf DateTime     @db.Date
  y2027          Json
  y2026          Json
  perCapita2027  Decimal      @db.Decimal(14, 2)
  perCapita2026  Decimal      @db.Decimal(14, 2)
  billLocator    String

  @@id([snapshotId, code])
}

model LegislativeEvent {
  id         String         @id
  date       DateTime       @db.Date
  type       String
  title      String
  note       String?
  document   SourceDocument @relation(fields: [documentId], references: [id])
  documentId String
}

/// Bulgarian municipality, keyed by the official code used in EKATTE/SIGMA (e.g. "BGS01").
model Municipality {
  id             String    @id @default(cuid())
  code           String    @unique
  nameBg         String
  province       String
  population     Int?
  populationAsOf DateTime? @db.Date
}

model PoliticalStatement {
  id            String   @id
  speaker       String
  saidOn        DateTime @db.Date
  title         String
  platform      String
  summary       String
  budgetVersion String
  /// SourceDocument ids (media articles, posts) — first is the primary reproduction
  documentIds   String[]
  claims        Claim[]
}

model Claim {
  id                 String             @id
  statement          PoliticalStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementId        String
  ordinal            Int
  topic              String
  kind               String // factual | forecast | opinion
  quote              String // short verbatim quotation
  verdict            String // Потвърдено | Частично вярно | Подвеждащо | Невярно | Недостатъчно данни | Прогноза | Мнение
  reasoning          String
  context            String?
  governmentPosition String?
  figures            Json
  calculation        Json?
  reviewedBy         String
  reviewedOn         DateTime           @db.Date
  evidence           ClaimEvidence[]
}

model ClaimEvidence {
  claim         Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId       String
  observation   MetricObservation @relation(fields: [observationId], references: [id])
  observationId String
  role          String // evidence | counter-evidence | context

  @@id([claimId, observationId])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  role      Role       @default(viewer)
  createdAt DateTime   @default(now())
  audit     AuditLog[]
}

model AuditLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  user    User?    @relation(fields: [userId], references: [id])
  userId  String?
  action  String
  target  String
  details Json?
}
