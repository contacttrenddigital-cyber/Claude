# PostgreSQL (локално: service postgresql start; виж CLAUDE.md)
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget2027?schema=public"

# SIGMA Budget open data (read-only, no key required)
SIGMA_BASE_URL="https://sigma-budget.midt.bg"

# Set to 1 to run live integration tests against SIGMA
SIGMA_LIVE=0

# Public site URL (sitemap, canonical links)
SITE_URL="http://localhost:3000"

# Admin panel: at least 32 random characters; leave empty to disable /admin.
# Create users with: ADMIN_PASSWORD='…' npx tsx scripts/create-user.ts --email you@example.org --role publisher
SESSION_SECRET=""
