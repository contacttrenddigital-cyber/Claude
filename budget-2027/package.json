{
  "name": "budget-2027",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "NODE_USE_ENV_PROXY=1 SIGMA_LIVE=1 vitest run tests/integration",
    "test:e2e": "playwright test --trace off",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "check:skills": "node scripts/check-skills.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:skills && npm test",
    "sources:fetch": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-sources.ts",
    "extract": "python3 -I scripts/extract/docx_tables.py data/raw/parliament/52-602-01-71.docx data/extracted/52-602-01-71.tables.json && unzip -o -q data/raw/parliament/52-602-01-71.docx \"word/media/*\" -d data/extracted/emf && python3 -I scripts/extract/emf_table.py data/extracted/52-602-01-71.annex3.json \"Приложение № 3: КФП 2025-2029\" data/extracted/emf/word/media/image16.emf data/extracted/emf/word/media/image17.emf data/extracted/emf/word/media/image18.emf data/extracted/emf/word/media/image19.emf",
    "snapshot:build": "NODE_USE_ENV_PROXY=1 tsx scripts/build-snapshot.ts",
    "db:seed": "tsx scripts/seed-snapshot.ts",
    "db:publish": "tsx scripts/seed-snapshot.ts --publish --by",
    "db:migrate:deploy": "prisma migrate deploy",
    "docs:dictionary": "tsx scripts/gen-data-dictionary.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "d3": "^7.9.2",
    "decimal.js": "^10.6.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
